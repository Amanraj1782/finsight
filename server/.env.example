PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/finsight
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: separate stable random key (32+ characters) for encrypting authenticator secrets.
# If omitted, JWT_SECRET is used. Never change the effective encryption key after enabling 2FA.
# MFA_ENCRYPTION_KEY=

# Optional free local AI assistant (install Ollama and download the model first).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Verification emails: use your mail provider's SMTP settings. Never commit credentials.
# Port 465 uses TLS immediately; other remote ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
